# Variáveis privadas. Configurar na raiz junto ao package.json ou na hospedagem.
# Node.js 22.13+ (recomendado: Node.js 24 LTS), com node:sqlite disponível.
# Caminho ABSOLUTO, privado, fora de public e em volume persistente.
ADMIN_DATABASE_PATH=C:/tech/site-assinatura-starter/app/.admin-data/admin.sqlite
ADMIN_SITE_ORIGIN=http://localhost:3000
# Produção:
# ADMIN_DATABASE_PATH=/var/lib/marquesano/admin.sqlite
# ADMIN_SITE_ORIGIN=https://marquesano.com.br
# Provisionar OWNER pelo e-mail, sem alterar usuários existentes: gere o hash com admin-password-hash.mjs.
# Configure o hash literal no painel da hospedagem (preserve todos os caracteres $).
ADMIN_INITIAL_OWNER_EMAIL=
ADMIN_INITIAL_OWNER_PASSWORD_HASH=
