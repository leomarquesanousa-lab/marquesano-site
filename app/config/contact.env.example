# Copiar estas variáveis para o painel da hospedagem ou .env.local NA RAIZ do projeto.
# Não usar prefixo NEXT_PUBLIC_ e não versionar valores reais.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Endereço de remetente em domínio verificado no Resend (somente e-mail, sem nome).
CONTACT_FROM_EMAIL=
# Segredo aleatório de pelo menos 32 caracteres. Gere localmente com crypto.randomBytes.
CONTACT_FORM_SECRET=
CONTACT_SITE_ORIGIN=https://marquesano.com.br
# Opcional: somente se a hospedagem garantir a autenticidade do cabeçalho de IP.
CONTACT_TRUSTED_IP_HEADER=
