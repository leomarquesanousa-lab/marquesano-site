# Server only. Never use a NEXT_PUBLIC_ prefix for this credential.
MERCADOPAGO_ACCESS_TOKEN=
# Secret generated in Your integrations > Webhooks, for the same application/environment.
MERCADOPAGO_WEBHOOK_SECRET=
# Existing admin origin, also used for CSRF and the checkout return URL.
ADMIN_SITE_ORIGIN=https://marquesano.com.br
# Existing ADMIN_DATABASE_PATH must point to persistent private SQLite storage.
