# Somente no .env da raiz do projeto (junto ao package.json) ou na hospedagem.
# Nunca prefixar estas variáveis com NEXT_PUBLIC_. Nenhum segredo vai ao navegador.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://marquesano.com.br/api/admin/meta/callback
# META_REDIRECT_URI precisa usar a mesma origem de ADMIN_SITE_ORIGIN.
# Desenvolvimento local (App Meta deve aceitar esta URI):
# META_REDIRECT_URI=http://localhost:3000/api/admin/meta/callback
#
# Opcional: chave de 32 bytes em hexadecimal (64 caracteres) para AES-256-GCM.
# Se ausente, a chave é derivada de META_APP_SECRET + META_APP_ID via HKDF-SHA256.
# Não perder/alterar a chave sem reconectar a Meta. Guardá-la separada do banco.
META_TOKEN_ENCRYPTION_KEY=
# Sem META_ACCESS_TOKEN manual. Tokens são obtidos via OAuth e cifrados no banco.
# A conta de anúncios é selecionada no painel após a autorização.
